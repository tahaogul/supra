{
  "name": "supra-cli",
  "version": "0.1.0",
  "description": "Supabase Multi-Account CLI Manager — manage multiple Supabase accounts from one terminal",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "supra": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "supabase",
    "cli",
    "multi-account",
    "manager",
    "database"
  ],
  "author": "tahaogul",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tahaogul/supra.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "conf": "^13.1.0",
    "inquirer": "^12.6.0",
    "node-fetch": "^3.3.2",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
